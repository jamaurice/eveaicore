#!/bin/sh
# EVE NeuroSystems LLC authorship guard (pre-push).
# Reject pushing any commit whose AUTHOR is not an allowed owner identity,
# or that carries a Co-Authored-By trailer. Backstop for rebase/cherry-pick/amend.
ALLOWED_A='admin@eveaicore\.com|36283126\+jamaurice@users\.noreply\.github\.com|49699333\+dependabot\[bot\]@users\.noreply\.github\.com'
z=0000000000000000000000000000000000000000
fail=0
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha --not --remotes=origin"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list $range 2>/dev/null); do
    ae="$(git show -s --format='%ae' "$c")"
    echo "$ae" | grep -qE "^($ALLOWED_A)$" || { echo "BLOCKED $c : disallowed author <$ae>" >&2; fail=1; }
    git show -s --format='%B' "$c" | grep -qiE '^[[:space:]]*co-authored-by[[:space:]]*:' && { echo "BLOCKED $c : Co-Authored-By trailer present" >&2; fail=1; }
  done
done
[ "$fail" -eq 0 ] || { echo "EVE authorship guard: PUSH REJECTED. Remove co-author trailers / fix author metadata, then retry." >&2; exit 1; }
exit 0
